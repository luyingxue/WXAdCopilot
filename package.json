{
  "name": "wxadcopilot",
  "version": "0.2.1",
  "private": true,
  "description": "本地优先的视频号带货投流量化分析与智能盯盘桌面工具",
  "author": "ZWill <support@zwill.org>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/luyingxue/WXAdCopilot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luyingxue/WXAdCopilot.git"
  },
  "bugs": {
    "url": "https://github.com/luyingxue/WXAdCopilot/issues"
  },
  "main": "dist-electron/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"tsc -p tsconfig.electron.json --watch --preserveWatchOutput\" \"wait-on tcp:5173 file:dist-electron/main/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.electron.json && vite build",
    "start": "electron .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test:architecture": "node tests/architecture.mjs",
    "test:smoke": "npm run build && npm run test:architecture && node tests/product-analysis-export.mjs && node tests/smoke.mjs",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "echarts": "^6.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.62.1",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "wait-on": "^9.0.4"
  },
  "build": {
    "appId": "com.wxadcopilot.desktop",
    "productName": "WXAdCopilot",
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "directories": {
      "output": "release"
    }
  }
}
